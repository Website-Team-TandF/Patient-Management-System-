# Frontend Environment Variables
# Copy this file to .env.local or .env.production and fill in the actual values
# NEVER commit actual .env files to git

# API Configuration
# For development: typically http://localhost:3000/api
# For production: your deployed backend URL (e.g., https://api.yourdomain.com/api)
VITE_API_URL=http://localhost:3000/api

# Build mode - automatically set by Vite
# Do not modify this manually
# NODE_ENV=development
